{
  // job-board.io deploys as a Cloudflare Worker with static assets (`npx wrangler
  // deploy`), NOT as a Pages project. The Worker owns every route so that auth,
  // security headers, and the apex redirect apply to pages as well as /api/*.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-board-io",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // run_worker_first matters: by default a request matching an uploaded file is
  // served straight from the edge and the Worker never runs, which would skip
  // the security headers on every page.
  //
  // html_handling must be "none". Its default ("auto-trailing-slash") makes the
  // asset server 301 /index.html to / and /app.html to /app - which, combined
  // with the Worker mapping / to /index.html, is an infinite redirect loop.
  // With both handlers off the asset server is a literal file server and
  // worker.js owns every routing decision.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Cron drives both halves of the background work: refreshing boards whose
  // interval has elapsed, and evaluating notification rules. Cloudflare's
  // minimum granularity is one minute; five keeps invocations cheap while
  // still feeling live behind the 20s client poll.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Per-IP throttles. Login/signup is the one endpoint worth protecting at the
  // edge - without it, credential stuffing is free and the per-account lockout
  // in the users table only slows an attacker down one account at a time.
  "unsafe": {
    "bindings": [
      {
        "name": "AUTH_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "2001",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "API_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "2002",
        "simple": { "limit": 120, "period": 60 }
      }
    ]
  },

  // `wrangler deploy` is declarative: it reconciles the Worker to this file on
  // every deploy, so bindings have to live here and not in the dashboard.
  // Replace database_id after running: wrangler d1 create job-board
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-board",
      "database_id": "REPLACE_WITH_ID_FROM_WRANGLER_D1_CREATE"
    }
  ],

  // Not secrets. Secrets (TOTP_ENC_KEY, SESSION_PEPPER, ANTHROPIC_API_KEY,
  // RESEND_API_KEY) are set with `wrangler secret put` - see README.
  "vars": {
    "SITE_URL": "https://job-board.io",
    "NOTIFY_FROM": "alerts@job-board.io",
    "SCORING_MODEL": "claude-opus-5"
  }
}
