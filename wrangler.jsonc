{
  // job-boards.io deploys as a Cloudflare Worker with static assets (`npx wrangler
  // deploy`), NOT as a Pages project. The Worker owns every route so that auth,
  // security headers, and the apex redirect apply to pages as well as /api/*.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-boards-io",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Without this the Worker only ever answers on <name>.<subdomain>.workers.dev.
  // "custom_domain": true makes Cloudflare create and maintain the DNS records
  // itself, so there is no separate A/CNAME step - the zone just has to already
  // exist in the same Cloudflare account.
  //
  // www is listed because the Worker 301s it to the apex; if www never reaches
  // the Worker, that redirect can never run.
  // CUTOVER IN PROGRESS - restored once job-board-io releases the hostname.
  // "routes": [
  //   { "pattern": "job-boards.io", "custom_domain": true },
  //   { "pattern": "www.job-boards.io", "custom_domain": true }
  // ],

  // run_worker_first matters: by default a request matching an uploaded file is
  // served straight from the edge and the Worker never runs, which would skip
  // the security headers on every page.
  //
  // html_handling must be "none". Its default ("auto-trailing-slash") makes the
  // asset server 301 /index.html to / and /app.html to /app - which, combined
  // with the Worker mapping / to /index.html, is an infinite redirect loop.
  // With both handlers off the asset server is a literal file server and
  // worker.js owns every routing decision.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Cron drives both halves of the background work: refreshing boards whose
  // interval has elapsed, and evaluating notification rules. Cloudflare's
  // minimum granularity is one minute; five keeps invocations cheap while
  // still feeling live behind the 20s client poll.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Per-IP throttles. Login/signup is the one endpoint worth protecting at the
  // edge - without it, credential stuffing is free and the per-account lockout
  // in the users table only slows an attacker down one account at a time.
  "unsafe": {
    "bindings": [
      {
        "name": "AUTH_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "2001",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "API_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "2002",
        "simple": { "limit": 120, "period": 60 }
      }
    ]
  },

  // `wrangler deploy` is declarative: it reconciles the Worker to this file on
  // every deploy, so bindings have to live here and not in the dashboard.
  // The id is not a secret - it names a database that only this account's
  // credentials can reach.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-board",
      "database_id": "fbea37e3-a19c-4f0c-a670-91dd3fec6800"
    }
  ],

  // `wrangler deploy` is declarative about plain-text vars: without this it
  // reconciles the Worker to exactly the list below and DELETES anything else,
  // including variables added through the dashboard. Since this project is
  // configured from the dashboard rather than the CLI, that silently wiped an
  // API key on every CI deploy - eight times before anyone noticed, because
  // the app degrades quietly when a key is absent.
  //
  // Encrypted secrets were never affected; they are managed separately and
  // survive deploys either way. This protects the plain-text ones too.
  //
  // The trade-off: removing a var from this file no longer removes it from the
  // Worker. Delete those in the dashboard.
  "keep_vars": true,

  // Not secrets. Secrets (TOTP_ENC_KEY, PASSWORD_PEPPER, SESSION_PEPPER,
  // ANTHROPIC_API_KEY, RESEND_API_KEY) must be added as *Secret* / encrypted,
  // never as plain text - see README.
  "vars": {
    // Echoed back by the AI check so a diagnostic can say which Worker it ran
    // on. Secrets kept appearing correct in the dashboard while being invisible
    // to the running code, and "which Worker am I actually looking at" was the
    // question nothing could answer.
    "WORKER_NAME": "job-boards-io",
    "SITE_URL": "https://job-boards.io",
    "NOTIFY_FROM": "alerts@job-boards.io",
    "SCORING_MODEL": "claude-opus-5"
  }
}
